// ─── FINANCE ─────────────────────────────────

model FeeStructure {
  id                  String       @id @default(cuid())
  schoolId            String
  school              School       @relation(fields: [schoolId], references: [id])
  academicYearId      String
  name                String
  nameAr              String?
