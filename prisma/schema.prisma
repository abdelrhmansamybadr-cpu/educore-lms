generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  DEVELOPER
  SCHOOL_ADMIN
  VICE_PRINCIPAL
  ACADEMIC_DIRECTOR
  DEPARTMENT_HEAD
  TEACHER
  SUB_TEACHER
  COUNSELOR
  STUDENT
  PARENT
  LIBRARIAN
  NURSE
  FINANCE_OFFICER
  HR_MANAGER
  STORE_MANAGER
  CANTEEN_MANAGER
  IT_ADMIN
  TRANSPORT_MANAGER
  RECEPTIONIST
  ADMISSION_OFFICER
  MATRON
  EVENT_COORDINATOR
  SUPPORT_AGENT
  ACTIVITIES_COORDINATOR
  REQUISITIONS_MANAGER
}

enum CurriculumType {
  EGYPTIAN
  SAUDI
  AMERICAN
  BRITISH
  IB
  CUSTOM
  MIXED
  NATIONAL
}

enum SchoolLanguage {
  ARABIC
  ENGLISH
  BILINGUAL
}

enum Currency {
  EGP
  SAR
  AED
  USD
  GBP
  EUR
  KWD
  BHD
  QAR
  JOD
  OMR
}

enum GradingSystem {
  PERCENTAGE
  GPA_4
  GCSE
  ALEVEL
  IB
  CUSTOM
}

enum ContentType {
  VIDEO
  PDF
  TEXT
  LINK
  AUDIO
  SCORM
  H5P
  PRESENTATION
  LIVE_SESSION
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_RESPONSE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  FILL_BLANK
  MATCHING
  ORDERING
  DRAG_DROP
  HOTSPOT
  MATH
  CODE
  AUDIO_RESPONSE
  FILE_UPLOAD
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  STRIPE
  PAYMOB
  FAWRY
  HYPERPAY
  TAP
  PAYTABS
  MOYASAR
  CASH
  BANK_TRANSFER
}

enum FeeType {
  TUITION
  BOOKS
  UNIFORM
  TRANSPORT
  CANTEEN
  ACTIVITIES
  EXAM
  REGISTRATION
  OTHER
}

enum DeviceOwnership {
  BYOD
  SCHOOL_DEVICE
  SHARED
  NO_DEVICE
}

enum DeviceType {
  LAPTOP_WINDOWS
  LAPTOP_MAC
  LAPTOP_LINUX
  TABLET_IPAD
  TABLET_ANDROID
  PHONE_IPHONE
  PHONE_ANDROID
  CHROMEBOOK
  DESKTOP
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  IT_SUPPORT
  BILLING
  ACADEMIC
  FACILITIES
  ADMISSION
  GENERAL
  BEHAVIOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  EARLY_DEPARTURE
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  ENROLLED
  WAITLISTED
}

// ─────────────────────────────────────────────
// CORE MODELS
// ─────────────────────────────────────────────

// ─── ORGANIZATION (SaaS tenant owner) ────────
model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  email       String    @unique
  phone       String?
  countryCode String    @default("US")
  plan        OrgPlan   @default(STARTER)
  isActive    Boolean   @default(true)
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  schools          School[]
  subscription     OrgSubscription?
  owners           OrgMember[]
  employees        User[]            @relation("OrgEmployees")
  purchaseRequests PurchaseRequest[] @relation("OrgPurchaseRequests")
  requisitions     Requisition[]     @relation("OrgRequisitions")
  jobApplications  JobApplication[]  @relation("OrgJobApplications")
}

model OrgMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  role           String       @default("OWNER") // OWNER, MANAGER, BILLING
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model OrgSubscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           OrgPlan      @default(STARTER)
  status         String       @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED, TRIALING
  maxSchools     Int          @default(1)
  maxStudents    Int          @default(500)
  stripeCustomerId  String?
  stripeSubId       String?
  currentPeriodEnd  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum OrgPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

// ─── SCHOOL ONBOARDING ───────────────────────
model OnboardingState {
  id         String   @id @default(cuid())
  schoolId   String   @unique
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  step       Int      @default(1)  // 1-6
  completed  Boolean  @default(false)
  data       Json     @default("{}")  // stores partial wizard data
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model School {
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  branchOf       String?       // parent school id for branches
  parentSchool   School?       @relation("SchoolBranches", fields: [branchOf], references: [id])
  branches       School[]      @relation("SchoolBranches")
  numberOfStudents Int?
  numberOfBranches Int         @default(1)
  id             String         @id @default(cuid())
  name           String
  nameAr         String?
  slug           String         @unique
  logo           String?
  coverImage     String?
  email          String
  phone          String?
  address        String?
  city           String?
  countryCode    String
  website        String?
  curriculumType CurriculumType @default(CUSTOM)
  language       SchoolLanguage @default(BILINGUAL)
  currency       Currency       @default(USD)
  timezone       String         @default("Africa/Cairo")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  onboardingState OnboardingState?
  settings       SchoolSettings?
  academicYears  AcademicYear[]
  gradeLevels    GradeLevel[]
  departments    Department[]
  subjects       Subject[]
  users          User[]
  courses        Course[]
  announcements  Announcement[]
  feeStructures  FeeStructure[]
  invoices       Invoice[]
  devices        Device[]
  tickets        Ticket[]
  busRoutes      BusRoute[]
  events         SchoolEvent[]
  modules        SchoolModuleConfig[]
  books          Book[]
  badges         Badge[]
  staffProfiles  StaffProfile[] @relation("StaffProfiles")
  canteenItems   CanteenItem[]  @relation("CanteenItems")
  storeItems          StoreItem[]         @relation("StoreItems")
  storeItemRequests   StoreItemRequest[]  @relation("SchoolStoreItemRequests")
  boardingRooms  BoardingRoom[] @relation("BoardingRooms")
  visitorLogs    VisitorLog[]   @relation("VisitorLogs")
  disciplinaryRecords DisciplinaryRecord[] @relation("DisciplinaryRecords")
  counselingSessions  CounselingSession[]  @relation("CounselingSessions")
  studentDocuments    StudentDocument[]    @relation("StudentDocuments")
  behaviorNotes       BehaviorNote[]       @relation("BehaviorNotes")
  purchaseRequests    PurchaseRequest[]    @relation("SchoolPurchaseRequests")
  requisitions        Requisition[]        @relation("SchoolRequisitions")
  jobApplications     JobApplication[]     @relation("SchoolJobApplications")
}

model SchoolSettings {
  id                  String  @id @default(cuid())
  schoolId            String  @unique
  school              School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Payment Gateways
  stripeEnabled       Boolean @default(false)
  stripePublicKey     String?
  paymobEnabled       Boolean @default(false)
  fawryEnabled        Boolean @default(false)
  hyperpayEnabled     Boolean @default(false)
  tapEnabled          Boolean @default(false)
  paytabsEnabled      Boolean @default(false)
  moyasarEnabled      Boolean @default(false)

  // Academic
  gradingSystem         GradingSystem @default(PERCENTAGE)
  attendanceMethod      String        @default("MANUAL") // MANUAL, QR, BIOMETRIC
  allowParentMessages   Boolean       @default(true)
  allowStudentMessages  Boolean       @default(true)
  lateSubmissionAllowed Boolean       @default(true)
  latePenaltyPercent    Int           @default(10)

  // Curriculum-specific config (JSON blobs per curriculum type)
  // Stored as JSON for maximum flexibility — parsed by config engine
  gradingConfig       Json?   // e.g. GPA scale, pass mark, grade boundaries
  termStructure       Json?   // number of terms, names, dates template
  reportCardTemplate  String? @default("STANDARD") // STANDARD, GPA, GCSE, IB, CUSTOM
  transcriptTemplate  String? @default("STANDARD")
  passMark            Int     @default(50)
  gpaScale            Float   @default(4.0)

  // Features
  enableBiometrics    Boolean @default(false)
  enableQrAttendance  Boolean @default(false)
  enableAiFeatures    Boolean @default(true)
  enableParentPortal  Boolean @default(true)
  enableStudentPortal Boolean @default(true)
  enablePublicCalendar Boolean @default(false)

  // Branding
  primaryColor   String? @default("#1E3A5F")
  accentColor    String? @default("#2DD4BF")
  customDomain   String?
}

model SchoolModuleConfig {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  module   String  // module name: 'FINANCE', 'LIBRARY', etc.
  enabled  Boolean @default(true)

  @@unique([schoolId, module])
}

// ─── USERS ───────────────────────────────────

model User {
  id          String    @id @default(cuid())
  email       String
  password    String?
  role        Role
  schoolId    String?
  school      School?        @relation(fields: [schoolId], references: [id])
  organizationId String?
  organization   Organization? @relation("OrgEmployees", fields: [organizationId], references: [id])
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  profile           UserProfile?
  refreshTokens     RefreshToken[]
  sentMessages      Message[]         @relation("SentMessages")
  notifications     Notification[]
  enrollments       Enrollment[]
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  grades            Grade[]
  attendanceRecords AttendanceRecord[]
  devices           Device[]
  parentLinks       ParentStudentLink[] @relation("ParentLinks")
  childLinks        ParentStudentLink[] @relation("ChildLinks")
  bookLoans         BookLoan[]
  healthRecord          HealthRecord?          @relation("StudentHealthRecords")
  healthVisits          HealthVisit[]          @relation("StudentHealthVisits")
  badges                UserBadge[]
  points                UserPoints?
  eventRegistrations    EventRegistration[]    @relation("EventRegistrations")
  mentalHealthCheckIns  MentalHealthCheckIn[]  @relation("MentalHealthCheckIns")
  organizedEvents       SchoolEvent[]          @relation("OrganizerEvents")
  driverRoutes          BusRoute[]             @relation("DriverRoutes")
  staffProfile          StaffProfile?          @relation("StaffProfile")
  canteenOrders         CanteenOrder[]         @relation("CanteenOrders")
  ticketMessages        TicketMessage[]        @relation("TicketMessages")
  deviceCheckouts       DeviceCheckout[]       @relation("DeviceCheckouts")
  boardingOccupancies   BoardingOccupant[]     @relation("BoardingOccupants")
  disciplinaryRecords   DisciplinaryRecord[]   @relation("StudentDisciplinary")
  reportedDisciplinary  DisciplinaryRecord[]   @relation("ReportedDisciplinary")
  counselingAsStudent   CounselingSession[]    @relation("StudentCounseling")
  counselorSessions     CounselingSession[]    @relation("CounselorSessions")
  studentDocuments      StudentDocument[]      @relation("StudentDocuments")
  issuedDocuments       StudentDocument[]      @relation("IssuedDocuments")
  behaviorNotes         BehaviorNote[]         @relation("StudentBehavior")
  addedBehaviorNotes    BehaviorNote[]         @relation("AddedBehaviorNotes")
  requestedPurchases    PurchaseRequest[]      @relation("RequestedPurchases")
  reviewedPurchases     PurchaseRequest[]      @relation("ReviewedPurchases")
  requestedRequisitions Requisition[]          @relation("RequestedRequisitions")
  reviewedRequisitions  Requisition[]          @relation("ReviewedRequisitions")
  reviewedJobApps       JobApplication[]       @relation("ReviewedJobApplications")
  storeItemRequests     StoreItemRequest[]     @relation("UserStoreItemRequests")
  storeItemApprovals    StoreItemRequest[]     @relation("UserStoreItemApprovals")

  @@unique([email, schoolId])
  @@index([schoolId, role])
}

model UserProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  firstNameAr  String?
  lastName     String
  lastNameAr   String?
  avatar       String?
  phone        String?
  dateOfBirth  DateTime?
  gender       String?   // MALE, FEMALE
  nationality  String?
  address      String?
  language     String    @default("ar") // ar or en
  studentId    String?   // School student ID number
  nationalId   String?   // Government ID
}

model ParentStudentLink {
  id        String @id @default(cuid())
  parentId  String
  studentId String
  parent    User   @relation("ParentLinks", fields: [parentId], references: [id])
  student   User   @relation("ChildLinks", fields: [studentId], references: [id])
  relationship String @default("PARENT") // PARENT, GUARDIAN, SIBLING

  @@unique([parentId, studentId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── ACADEMIC STRUCTURE ───────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  nameAr    String?
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  terms     Term[]
  invoices  Invoice[]

  @@unique([schoolId, name])
}

model Term {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  nameAr         String?
  startDate      DateTime
  endDate        DateTime
  order          Int
}

model Department {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  name     String
  nameAr   String?
  headId   String?  // Department Head user id
  subjects Subject[]
}

model GradeLevel {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id])
  name         String    // "Grade 5", "Year 7", "الصف الخامس"
  nameAr       String?
  order        Int
  sections     Section[]
  feeStructures FeeStructure[]
}

model Section {
  id           String     @id @default(cuid())
  gradeLevelId String
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id])
  name         String     // "A", "B", "C"
  teacherId    String?    // homeroom teacher
  capacity     Int?
  enrollments  Enrollment[]
}

model Subject {
  id           String      @id @default(cuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  name         String
  nameAr       String?
  code         String?
  courses      Course[]
}

// ─── COURSES & CONTENT ───────────────────────

model Course {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  teacherId   String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  title       String
  titleAr     String?
  description String?
  descAr      String?
  coverImage  String?
  isPublished Boolean  @default(false)
  sections    CourseSection[]
  enrollments Enrollment[]
  assignments Assignment[]
  quizzes     Quiz[]
  liveClasses LiveClass[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseSection {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  titleAr  String?
  order    Int
  lessons  Lesson[]
}

model Lesson {
  id               String        @id @default(cuid())
  sectionId        String
  section          CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title            String
  titleAr          String?
  contentType      ContentType
  content          Json          // flexible content data (URLs, HTML, etc.)
  order            Int
  isPublished      Boolean       @default(false)
  availableFrom    DateTime?
  estimatedMinutes Int?
  isRequired       Boolean       @default(true)
  progressRecords  LessonProgress[]
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  sectionId   String?
  section     Section?  @relation(fields: [sectionId], references: [id])
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  progress    Float     @default(0)

  @@unique([studentId, courseId])
}

model LessonProgress {
  id           String   @id @default(cuid())
  studentId    String
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id])
  isCompleted  Boolean  @default(false)
  lastPosition Int?
  completedAt  DateTime?

  @@unique([studentId, lessonId])
}

// ─── ASSIGNMENTS ──────────────────────────────

model Assignment {
  id                  String     @id @default(cuid())
  courseId            String
  course              Course     @relation(fields: [courseId], references: [id])
  title               String
  titleAr             String?
  instructions        String
  instructionsAr      String?
  type                String     @default("FILE_UPLOAD")
  maxPoints           Float
  dueDate             DateTime
  allowLate           Boolean    @default(true)
  latePenaltyPercent  Float?
  maxAttempts         Int        @default(1)
  isGroupWork         Boolean    @default(false)
  isPeerReview        Boolean    @default(false)
  isAnonymousGrading  Boolean    @default(false)
  isPublished         Boolean    @default(false)
  submissions         Submission[]
  createdAt           DateTime   @default(now())
}

model Submission {
  id               String     @id @default(cuid())
  assignmentId     String
  assignment       Assignment @relation(fields: [assignmentId], references: [id])
  studentId        String
  student          User       @relation(fields: [studentId], references: [id])
  submittedAt      DateTime   @default(now())
  isLate           Boolean    @default(false)
  files            String[]
  textContent      String?
  linkUrl          String?
  score            Float?
  feedback         String?
  feedbackAudioUrl String?
  similarityPercent Float?
  gradedAt         DateTime?
  gradedById       String?

  @@unique([assignmentId, studentId])
}

// ─── QUIZZES ──────────────────────────────────

model Quiz {
  id                 String       @id @default(cuid())
  courseId           String
  course             Course       @relation(fields: [courseId], references: [id])
  title              String
  titleAr            String?
  instructions       String?
  timeLimitMinutes   Int?
  maxAttempts        Int          @default(1)
  passingScore       Float?
  randomizeQuestions Boolean      @default(false)
  randomizeAnswers   Boolean      @default(false)
  showOneAtATime     Boolean      @default(false)
  allowBacktrack     Boolean      @default(true)
  isPublished        Boolean      @default(false)
  availableFrom      DateTime?
  availableUntil     DateTime?
  questions          Question[]
  attempts           QuizAttempt[]
  createdAt          DateTime     @default(now())
}

model QuestionBank {
  id       String     @id @default(cuid())
  schoolId String
  name     String
  nameAr   String?
  subjectId String?
  questions Question[]
}

model Question {
  id            String       @id @default(cuid())
  quizId        String?
  quiz          Quiz?        @relation(fields: [quizId], references: [id])
  bankId        String?
  bank          QuestionBank? @relation(fields: [bankId], references: [id])
  type          QuestionType
  text          String
  textAr        String?
  imageUrl      String?
  points        Float        @default(1)
  difficulty    String       @default("MEDIUM")
  tags          String[]
  options       QuestionOption[]
  correctAnswer Json?        // string or string[]
  explanation   String?
  explanationAr String?
  order         Int          @default(0)
  answers       AttemptAnswer[]
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  textAr     String?
  isCorrect  Boolean  @default(false)
  order      Int
}

model QuizAttempt {
  id          String          @id @default(cuid())
  quizId      String
  quiz        Quiz            @relation(fields: [quizId], references: [id])
  studentId   String
  student     User            @relation(fields: [studentId], references: [id])
  startedAt   DateTime        @default(now())
  submittedAt DateTime?
  score       Float?
  percentage  Float?
  isPassed    Boolean?
  answers     AttemptAnswer[]
}

model AttemptAnswer {
  id           String      @id @default(cuid())
  attemptId    String
  attempt      QuizAttempt @relation(fields: [attemptId], references: [id])
  questionId   String
  question     Question    @relation(fields: [questionId], references: [id])
  answer       Json        // string or string[]
  isCorrect    Boolean?
  pointsEarned Float?
  aiScore      Float?
  teacherScore Float?
}

// ─── GRADEBOOK ───────────────────────────────

model Grade {
  id           String      @id @default(cuid())
  studentId    String
  student      User        @relation(fields: [studentId], references: [id])
  courseId     String
  assignmentId String?
  quizId       String?
  points       Float
  maxPoints    Float
  percentage   Float?
  letterGrade  String?
  feedback     String?
  isExcused    Boolean     @default(false)
  isMissing    Boolean     @default(false)
  gradedAt     DateTime    @default(now())
  gradedById   String?
}

// ─── ATTENDANCE ──────────────────────────────

model AttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  student   User             @relation(fields: [studentId], references: [id])
  courseId  String?
  date      DateTime         @db.Date
  period    Int?             // lesson period number
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  markedById String?
  markedAt  DateTime         @default(now())

  @@unique([studentId, courseId, date, period])
  @@index([studentId, date])
}

// ─── MESSAGING ───────────────────────────────

model Conversation {
  id           String    @id @default(cuid())
  schoolId     String
  isGroup      Boolean   @default(false)
  name         String?
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime  @default(now())
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  contentType    String       @default("TEXT") // TEXT, VOICE, IMAGE, FILE
  fileUrl        String?
  isTranslated   Boolean      @default(false)
  translatedContent String?
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  titleAr   String?
  body      String
  bodyAr    String?
  type      String   // GRADE, ATTENDANCE, ASSIGNMENT, MESSAGE, etc.
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  authorId  String
  title     String
  titleAr   String?
  content   String
  contentAr String?
