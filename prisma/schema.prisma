  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation("OrgPurchaseRequests", fields: [organizationId], references: [id])
  schoolId        String?
  school          School?         @relation("SchoolPurchaseRequests", fields: [schoolId], references: [id])
  requestedById   String
  requestedBy     User            @relation("RequestedPurchases", fields: [requestedById], references: [id])
  reviewedById    String?
  reviewedBy      User?           @relation("ReviewedPurchases", fields: [reviewedById], references: [id])

  title           String
  description     String
  category        PurchaseCategory @default(OTHER)
  estimatedCost   Float
  currency        String           @default("USD")
  quantity        Int              @default(1)
  vendor          String?
  urgency         String           @default("NORMAL")
  status          RequestStatus    @default(PENDING)
  justification   String?
  attachmentUrl   String?
  reviewNotes     String?
  approvedCost    Float?

  requestedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  neededBy        DateTime?

  @@index([organizationId])
  @@index([status])
}

model Requisition {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation("OrgRequisitions", fields: [organizationId], references: [id])
  schoolId        String?
  school          School?             @relation("SchoolRequisitions", fields: [schoolId], references: [id])
  requestedById   String
  requestedBy     User                @relation("RequestedRequisitions", fields: [requestedById], references: [id])
  reviewedById    String?
  reviewedBy      User?               @relation("ReviewedRequisitions", fields: [reviewedById], references: [id])

  title           String
  description     String
  category        RequisitionCategory @default(OTHER)
  items           Json
  totalEstimated  Float               @default(0)
  status          RequestStatus       @default(PENDING)
  urgency         String              @default("NORMAL")
  deliveryDate    DateTime?
  reviewNotes     String?
  attachmentUrl   String?

  // Pricing step (Requisitions Manager adds prices)
  pricedItems         Json?
  totalPriced         Float?
  pricedById          String?
  pricedAt            DateTime?

  // Approval step
  rejectionReason     String?

  // Finance pre-approval step (Finance Officer approves before owner)
  financeApprovedAt    DateTime?
  financeApprovedById  String?
  isEscalatedToOwner   Boolean           @default(false)

  // Money release step (Finance releases funds to RM)
  moneyReleasedAt      DateTime?
  moneyReleasedById    String?

  // RM confirms money received
  moneyReceivedAt      DateTime?
  moneyReceivedById    String?

  // RM purchases items + uploads invoice
  purchasedAt          DateTime?
  purchasedById        String?
  purchaseInvoiceUrls  String[]          @default([])

  // Store receipt (what was actually received vs ordered)
  storeReceivedItems   Json?             // [{name,orderedQty,receivedQty,unit,note}]
  storeNotes           String?
  storeConfirmedAt     DateTime?
  storeConfirmedById   String?
  storeHasIssue        Boolean           @default(false)

  // Requester collection
  collectedAt          DateTime?

  // Legacy finance release
  financeReleasedAt    DateTime?
  financeReleasedById  String?

  // Items arrived (legacy)
  itemsArrivedAt      DateTime?
  itemsArrivedById    String?
  invoiceUrls         String[]          @default([])

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([status])
}

model JobApplication {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation("OrgJobApplications", fields: [organizationId], references: [id])
  schoolId        String?
  school          School?              @relation("SchoolJobApplications", fields: [schoolId], references: [id])
  reviewedById    String?
  reviewedBy      User?                @relation("ReviewedJobApplications", fields: [reviewedById], references: [id])

  fullName        String
  email           String
  phone           String?
  nationality     String?
  position        String
  department      String?
  employmentType  EmploymentType       @default(FULL_TIME)
  expectedSalary  Float?
  currency        String               @default("USD")
  experience      Int                  @default(0)
  education       String?
  university      String?
  skills          String[]             @default([])
  languages       String[]             @default([])
  coverLetter     String?
  cvUrl           String?
  linkedIn        String?
  portfolio       String?
  availableFrom   DateTime?

  status          JobApplicationStatus @default(RECEIVED)
  interviewDate   DateTime?
  interviewNotes  String?
  offerSalary     Float?
  rejectionReason String?
  internalNotes   String?

  // Owner hire-approval workflow
  ownerApprovalStatus      String?   // PENDING | APPROVED | REJECTED
  ownerApprovalNote        String?   // owner's rejection reason
  ownerApprovalRequestedAt DateTime?
  ownerApprovedAt          DateTime?

  appliedAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([organizationId])
  @@index([status])
}
