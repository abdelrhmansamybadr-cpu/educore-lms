// Journal Entries (Double-Entry Accounting)
model JournalEntry {
  id          String         @id @default(cuid())
  orgId       String
  org         Organization   @relation("OrgJournalEntries", fields: [orgId], references: [id])
  schoolId    String?
  entryNumber String
  date        DateTime
  description String
  reference   String?
  refType     String?
  status      JournalStatus  @default(DRAFT)
  isReversed  Boolean        @default(false)
  reversedBy  String?
  createdById String
  lines       JournalEntryLine[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([orgId, entryNumber])
  @@index([orgId])
  @@index([schoolId])
}

model JournalEntryLine {
  id         String         @id @default(cuid())
  entryId    String
  entry      JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId  String
  account    ChartOfAccount @relation(fields: [accountId], references: [id])
  debit      Decimal        @default(0) @db.Decimal(18, 2)
  credit     Decimal        @default(0) @db.Decimal(18, 2)
  memo       String?
  costCenter String?

  @@index([entryId])
  @@index([accountId])
}

// Budget Management
model Budget {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation("OrgBudgets", fields: [orgId], references: [id])
  schoolId    String
  name        String
  fiscalYear  Int
  startDate   DateTime
  endDate     DateTime
  status      BudgetStatus @default(DRAFT)
  totalAmount Decimal      @db.Decimal(18, 2)
  approvedById String?
  approvedAt  DateTime?
  items       BudgetItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
  @@index([schoolId])
}

model BudgetItem {
  id          String   @id @default(cuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountCode String?
  category    String
  amount      Decimal  @db.Decimal(18, 2)
  actualSpent Decimal  @default(0) @db.Decimal(18, 2)
  description String?

  @@index([budgetId])
}

// Fee Templates (for bulk invoice generation)
model FeeTemplate {
  id           String            @id @default(cuid())
  schoolId     String
  name         String
  academicYear String
  curriculum   String?
  gradeLevel   String?
  isActive     Boolean           @default(true)
  items        FeeTemplateItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([schoolId])
}

model FeeTemplateItem {
  id          String      @id @default(cuid())
  templateId  String
  template    FeeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  feeType     FeeType
  label       String?
  amount      Decimal     @db.Decimal(18, 2)
  currency    Currency    @default(SAR)
  isMandatory Boolean     @default(true)
  dueDate     DateTime?

  @@index([templateId])
}

// Payment Plans & Installments
model PaymentPlan {
  id           String               @id @default(cuid())
  invoiceId    String               @unique
  invoice      Invoice              @relation(fields: [invoiceId], references: [id])
  installments PaymentInstallment[]
  createdAt    DateTime             @default(now())
}

model PaymentInstallment {
  id       String        @id @default(cuid())
  planId   String
  plan     PaymentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  dueDate  DateTime
  amount   Decimal       @db.Decimal(18, 2)
  status   PaymentStatus @default(PENDING)
  paidAt   DateTime?

  @@index([planId])
}

// Discount Rules
model DiscountRule {
  id        String       @id @default(cuid())
  schoolId  String
  name      String
  nameAr    String?
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  feeTypes  String[]     @default([])
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([schoolId])
}

// Fine Rules (late payment penalties)
model FineRule {
  id         String       @id @default(cuid())
  schoolId   String
  name       String
  feeType    FeeType?
  graceDays  Int          @default(0)
  fineType   FineCalcType
  fineValue  Decimal      @db.Decimal(10, 2)
  maxFine    Decimal?     @db.Decimal(18, 2)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  @@index([schoolId])
}

// Credit Notes
model CreditNote {
  id           String           @id @default(cuid())
  orgId        String
  schoolId     String
  invoiceId    String?
  studentId    String
  amount       Decimal          @db.Decimal(18, 2)
  reason       String
  status       CreditNoteStatus @default(PENDING)
  issuedById   String
  approvedById String?
  approvedAt   DateTime?
  appliedAt    DateTime?
  createdAt    DateTime         @default(now())

  @@index([orgId])
  @@index([studentId])
}

// Payroll Runs
model PayrollRun {
  id              String           @id @default(cuid())
  orgId           String
  schoolId        String
  month           Int
  year            Int
  status          PayrollRunStatus @default(DRAFT)
  totalGross      Decimal          @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal          @default(0) @db.Decimal(18, 2)
  totalNet        Decimal          @default(0) @db.Decimal(18, 2)
  processedById   String?
  approvedById    String?
  paidAt          DateTime?
  slips           PayslipRecord[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([schoolId, month, year])
  @@index([orgId])
  @@index([schoolId])
}

model PayslipRecord {
  id                 String        @id @default(cuid())
  runId              String
  run                PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  staffId            String
  staff              StaffProfile  @relation("StaffPayslips", fields: [staffId], references: [id])
  baseSalary         Decimal       @db.Decimal(18, 2)
  overtime           Decimal       @default(0) @db.Decimal(18, 2)
  bonus              Decimal       @default(0) @db.Decimal(18, 2)
  allowances         Decimal       @default(0) @db.Decimal(18, 2)
  grossPay           Decimal       @db.Decimal(18, 2)
  taxDeduction       Decimal       @default(0) @db.Decimal(18, 2)
  insuranceDeduction Decimal       @default(0) @db.Decimal(18, 2)
  loanDeduction      Decimal       @default(0) @db.Decimal(18, 2)
  leaveDeduction     Decimal       @default(0) @db.Decimal(18, 2)
  otherDeductions    Decimal       @default(0) @db.Decimal(18, 2)
  totalDeductions    Decimal       @db.Decimal(18, 2)
  netPay             Decimal       @db.Decimal(18, 2)
  bankAccount        String?
  status             PayslipStatus @default(PENDING)

  @@unique([runId, staffId])
  @@index([runId])
  @@index([staffId])
}

// Staff Loans
model StaffLoan {
  id                String     @id @default(cuid())
  staffId           String
  staff             StaffProfile @relation("StaffLoans", fields: [staffId], references: [id])
  schoolId          String
  amount            Decimal    @db.Decimal(18, 2)
  reason            String?
  totalInstallments Int
  paidInstallments  Int        @default(0)
  monthlyDeduction  Decimal    @db.Decimal(18, 2)
  status            StaffLoanStatus @default(PENDING)
  approvedById      String?
  startDate         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([staffId])
  @@index([schoolId])
}

// Expense Claims
model ExpenseClaim {
  id            String          @id @default(cuid())
  orgId         String
  schoolId      String
  submittedById String
  title         String
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(18, 2)
  currency      Currency        @default(SAR)
  date          DateTime
  description   String?
  receiptUrl    String?
  costCenter    String?
  status        ExpenseStatus   @default(PENDING)
  approvedById  String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orgId])
  @@index([schoolId])
  @@index([submittedById])
}

// Bank Accounts
model BankAccount {
  id             String         @id @default(cuid())
  orgId          String
  org            Organization   @relation("OrgBankAccounts", fields: [orgId], references: [id])
  schoolId       String?
  name           String
  accountNumber  String
  bankName       String
  iban           String?
  currency       Currency       @default(SAR)
  currentBalance Decimal        @default(0) @db.Decimal(18, 2)
  isDefault      Boolean        @default(false)
  isActive       Boolean        @default(true)
  statements     BankStatement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orgId])
}

model BankStatement {
  id               String      @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date             DateTime
  description      String
  amount           Decimal     @db.Decimal(18, 2)
  runningBalance   Decimal     @db.Decimal(18, 2)
  isReconciled     Boolean     @default(false)
  matchedPaymentId String?
  createdAt        DateTime    @default(now())

  @@index([bankAccountId])
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model FiscalYear {
  id          String           @id @default(cuid())
  orgId       String
  org         Organization     @relation("OrgFiscalYears", fields: [orgId], references: [id])
  name        String
  startDate   DateTime
  endDate     DateTime
  status      FiscalYearStatus @default(OPEN)
  closedAt    DateTime?
  closedById  String?
  periods     AccountingPeriod[]
  openingBalances OpeningBalance[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orgId])
}

model AccountingPeriod {
  id           String       @id @default(cuid())
  fiscalYearId String
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  name         String
  month        Int
  year         Int
  startDate    DateTime
  endDate      DateTime
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  createdAt    DateTime     @default(now())

  @@unique([fiscalYearId, month, year])
  @@index([fiscalYearId])
}

model OpeningBalance {
  id           String         @id @default(cuid())
  orgId        String
  org          Organization   @relation("OrgOpeningBalances", fields: [orgId], references: [id])
  schoolId     String?
  fiscalYearId String
  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  accountId    String
  account      ChartOfAccount @relation("AccountOpeningBalances", fields: [accountId], references: [id])
  debit        Decimal        @default(0) @db.Decimal(18, 2)
  credit       Decimal        @default(0) @db.Decimal(18, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([fiscalYearId, accountId])
  @@index([orgId])
}

model CostCenter {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation("OrgCostCenters", fields: [orgId], references: [id])
  schoolId    String?
  code        String
  name        String
  nameAr      String?
  description String?
  isActive    Boolean      @default(true)
  parentId    String?
  parent      CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children    CostCenter[] @relation("CostCenterHierarchy")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, code])
  @@index([orgId])
}

// ── Salary Workflow ────────────────────────────────────────────────────────

enum SalaryBatchStatus {
  DRAFT
  SUBMITTED
  FINANCE_REJECTED
  OWNER_PENDING
  OWNER_APPROVED
  OWNER_REJECTED
  IN_PAYMENT
  PAID
  CLOSED
}

model SalaryBatch {
  id                  String            @id @default(cuid())
  orgId               String
  schoolId            String?           // null = company-level batch (org staff)
  school              School?           @relation("SchoolSalaryBatches", fields: [schoolId], references: [id])
  month               Int
  year                Int
  status              SalaryBatchStatus @default(DRAFT)

  lines               SalaryBatchLine[]

  totalBaseSalary     Decimal           @default(0) @db.Decimal(18, 2)
  totalBonus          Decimal           @default(0) @db.Decimal(18, 2)
  totalDeductions     Decimal           @default(0) @db.Decimal(18, 2)
  totalNet            Decimal           @default(0) @db.Decimal(18, 2)

  // HR
  preparedById        String
  submittedAt         DateTime?
  submissionNote      String?

  // Finance review
  financeReviewedById String?
  financeReviewedAt   DateTime?
  financeNote         String?

  // Owner review
  ownerReviewedById   String?
  ownerReviewedAt     DateTime?
  rejectionReason     String?

  // Payment
  paidById            String?
  paidAt              DateTime?
  paymentNote         String?
  closedAt            DateTime?
  closedById          String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([schoolId, month, year])
  @@index([orgId])
  @@index([status])
}

model SalaryBatchLine {
  id          String       @id @default(cuid())
  batchId     String
  batch       SalaryBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  staffId     String
  staff       StaffProfile @relation("StaffSalaryLines", fields: [staffId], references: [id])

  baseSalary  Decimal      @default(0) @db.Decimal(18, 2)
  bonus       Decimal      @default(0) @db.Decimal(18, 2)
  deductions  Decimal      @default(0) @db.Decimal(18, 2)
  netPay      Decimal      @default(0) @db.Decimal(18, 2)
  notes       String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([batchId, staffId])
  @@index([batchId])
}
