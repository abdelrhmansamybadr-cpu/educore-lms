  score         Float     // 0-100
  communication Float     @default(0)
  punctuality   Float     @default(0)
  teamwork      Float     @default(0)
  performance   Float     @default(0)
  strengths     String?
  improvements  String?
  goals         String?
  createdAt     DateTime  @default(now())

  @@index([schoolId, staffId])
}

