# ─── Database ───────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/educore_db"

# ─── Redis ──────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── App ────────────────────────────────────
PORT=4000
NODE_ENV=development
WEB_URL="http://localhost:3000"

# ─── AWS ────────────────────────────────────
AWS_REGION="me-south-1"
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET="educore-uploads"
AWS_CLOUDFRONT_URL="https://your-cloudfront-domain.cloudfront.net"

# ─── Google OAuth ────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ─── Microsoft OAuth ─────────────────────────
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# ─── Email (AWS SES) ─────────────────────────
EMAIL_FROM="noreply@educore.app"
EMAIL_FROM_NAME="EduCore LMS"

# ─── Firebase (Push Notifications) ───────────
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# ─── Payment Gateways ────────────────────────
STRIPE_SECRET_KEY="sk_test_your-stripe-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
PAYMOB_API_KEY="your-paymob-api-key"
FAWRY_MERCHANT_CODE="your-fawry-code"
FAWRY_SECURITY_KEY="your-fawry-key"

# ─── AI (Claude API) ─────────────────────────
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ─── LiveKit (Live Classes) ──────────────────
LIVEKIT_URL="wss://your-livekit-server.com"
LIVEKIT_API_KEY="your-livekit-key"
LIVEKIT_API_SECRET="your-livekit-secret"
